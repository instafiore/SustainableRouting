<?xml version="1.0" encoding="UTF-8"?>

<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="joined_buslanes.net.xml"/>
        <route-files value="solutions/asp/final-3011.rou.xml"/>
        <additional-files value="joined_detectors.add.xml,joined_vtypes.add.xml"/>
    </input>

    <output>
        <emission-output value="emissions-asp.xml"/>
    </output>

    <report>
        <log value="log-asp.txt"/>
        <no-step-log value="false"/>
    </report>

    <time>
        <begin value="0"/>
        <end value="1000"/>
    </time>

</configuration>
